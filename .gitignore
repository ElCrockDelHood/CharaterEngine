# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ---- Virtual environments (never commit; use scripts/bootstrap.py) ----
.venv/
.venv-*/
venv/
env/

# ---- Local databases & secrets ----
*.db
*.sqlite
*.sqlite3
.env
.env.*

# ---- Blender / engine artifacts ----
*.blend1
*.blend2
*.blend@
builds/tmp/
builds/gltf/
builds/renders/
# Debug-console run logs (scripts/_logrun.py, docs/09_Debug_Consoles.md)
logs/

# ---- Godot ----
.godot/
*.import
runtime/godot/**/.godot/
runtime/godot/*.glb
runtime/godot/*.gltf
runtime/godot/*.bin
# regenerated by scripts/engine_tests.py (scripts/export_gltf.py --pose tpose)
runtime/godot/assets/*.glb

# ---- IDE / OS ----
.idea/
*.swp
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---- Temporary files ----
temp_*
tmp/
*.log

# Blender validation outputs (regenerated by runtime/upbge and scripts/validate_blender_headless.py)
builds/tests/upbge_validation.blend
# Engine test outputs (scripts/engine_tests.py): reports, .blend, .glb, logs
builds/tests/
builds/benchmarks/
builds/material_sample/
builds/reactions/
