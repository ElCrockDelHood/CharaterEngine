{
  "reconstruction_architecture": {
    "sprint": "A0.3",
    "date": "2026-08-13",
    "status": "ANALYSIS_ONLY",
    "purpose": "Architecture design for deterministic anatomical reconstruction system"
  },
  "architecture_overview": {
    "goal": "Transform abstract anatomical parameters into concrete 3D bone positions and orientations",
    "approach": "Layered reconstruction with dependency-driven sequence",
    "key_principles": [
      "Deterministic output (no random elements)",
      "Anatomically accurate (based on reference data)",
      "Validatable (clear validation checkpoints)",
      "Modular (independent components)",
      "Traceable (audit trail of decisions)"
    ]
  },
  "reconstruction_pipeline": {
    "stages": [
      {
        "stage": "1. INPUT_VALIDATION",
        "description": "Validate input parameters and reference data",
        "inputs": ["Subject profile", "Reference anthropometric data", "Target specifications"],
        "outputs": ["Validated parameter set", "Reference data index"],
        "dependencies": [],
        "current_status": "NOT_IMPLEMENTED"
      },
      {
        "stage": "2. GLOBAL_SCALING",
        "description": "Calculate global scaling factors from total height",
        "inputs": ["Total height", "Reference height"],
        "outputs": ["Global scale factor"],
        "dependencies": ["INPUT_VALIDATION"],
        "current_status": "NOT_IMPLEMENTED"
      },
      {
        "stage": "3. PELVIC_RECONSTRUCTION",
        "description": "Reconstruct pelvis as foundation for lower body",
        "inputs": ["Pelvic dimensions", "Pelvic orientation", "Global scale"],
        "outputs": ["Pelvic bone positions", "Hip joint centers"],
        "dependencies": ["GLOBAL_SCALING"],
        "current_status": "NOT_IMPLEMENTED"
      },
      {
        "stage": "4. SPINAL_RECONSTRUCTION",
        "description": "Reconstruct spine with natural curvatures",
        "inputs": ["Spine dimensions", "Curvature parameters", "Pelvic position"],
        "outputs": ["Vertebral positions", "Spine curve parameters"],
        "dependencies": ["PELVIC_RECONSTRUCTION"],
        "current_status": "NOT_IMPLEMENTED"
      },
      {
        "stage": "5. THORACIC_RECONSTRUCTION",
        "description": "Reconstruct thorax, ribs, and sternum",
        "inputs": ["Thoracic dimensions", "Spine positions", "Rib parameters"],
        "outputs": ["Thoracic bone positions", "Rib cage geometry"],
        "dependencies": ["SPINAL_RECONSTRUCTION"],
        "current_status": "NOT_IMPLEMENTED"
      },
      {
        "stage": "6. SHOULDER_GIRDLE_RECONSTRUCTION",
        "description": "Reconstruct clavicles and scapulae",
        "inputs": ["Shoulder girdle dimensions", "Thoracic positions"],
        "outputs": ["Clavicle positions", "Scapula positions", "Shoulder joint centers"],
        "dependencies": ["THORACIC_RECONSTRUCTION"],
        "current_status": "NOT_IMPLEMENTED"
      },
      {
        "stage": "7. UPPER_LIMB_RECONSTRUCTION",
        "description": "Reconstruct arms and forearms",
        "inputs": ["Upper limb dimensions", "Shoulder joint centers", "Elbow joint centers"],
        "outputs": ["Humerus positions", "Radius/ulna positions", "Elbow joint centers"],
        "dependencies": ["SHOULDER_GIRDLE_RECONSTRUCTION"],
        "current_status": "NOT_IMPLEMENTED"
      },
      {
        "stage": "8. HAND_RECONSTRUCTION",
        "description": "Reconstruct detailed hand anatomy",
        "inputs": ["Hand dimensions", "Wrist joint centers", "Hand arch parameters"],
        "outputs": ["Carpal positions", "Metacarpal positions", "Phalanx positions"],
        "dependencies": ["UPPER_LIMB_RECONSTRUCTION"],
        "current_status": "NOT_IMPLEMENTED"
      },
      {
        "stage": "9. LOWER_LIMB_RECONSTRUCTION",
        "description": "Reconstruct legs and feet",
        "inputs": ["Lower limb dimensions", "Hip joint centers", "Knee joint centers"],
        "outputs": ["Femur positions", "Tibia/fibula positions", "Knee joint centers"],
        "dependencies": ["PELVIC_RECONSTRUCTION"],
        "current_status": "NOT_IMPLEMENTED"
      },
      {
        "stage": "10. FOOT_RECONSTRUCTION",
        "description": "Reconstruct detailed foot anatomy",
        "inputs": ["Foot dimensions", "Ankle joint centers", "Foot arch parameters"],
        "outputs": ["Tarsal positions", "Metatarsal positions", "Toe phalanx positions"],
        "dependencies": ["LOWER_LIMB_RECONSTRUCTION"],
        "current_status": "NOT_IMPLEMENTED"
      },
      {
        "stage": "11. SKULL_RECONSTRUCTION",
        "description": "Reconstruct skull and facial bones",
        "inputs": ["Skull dimensions", "Cervical spine position"],
        "outputs": ["Cranial bone positions", "Facial bone positions"],
        "dependencies": ["SPINAL_RECONSTRUCTION"],
        "current_status": "NOT_IMPLEMENTED"
      },
      {
        "stage": "12. GLOBAL_VALIDATION",
        "description": "Validate entire skeleton for anatomical consistency",
        "inputs": ["All bone positions", "Validation constraints"],
        "outputs": ["Validation report", "Anomaly flags"],
        "dependencies": ["ALL_PREVIOUS_STAGES"],
        "current_status": "NOT_IMPLEMENTED"
      }
    ]
  },
  "core_components": {
    "parameter_normalizer": {
      "function": "Normalize input parameters to standard reference",
      "inputs": ["Raw parameters", "Reference anthropometric data"],
      "outputs": ["Normalized parameters"],
      "algorithms": ["Gender-specific normalization", "Age-specific normalization", "Height-based scaling"],
      "current_status": "NOT_IMPLEMENTED"
    },
    "proportion_calculator": {
      "function": "Calculate anatomical proportions from normalized parameters",
