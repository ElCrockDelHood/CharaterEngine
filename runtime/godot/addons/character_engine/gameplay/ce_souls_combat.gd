## Souls-like duel (STYLE-SOULS-001): stamina, dodge with i-frames, light / heavy attacks, poise, Sentinel.
##
## Line-by-line port of `character_engine.domain.gameplay.souls` (Python). Tuning, frame data, strike energies
## and the pre-computed wound assessments come from CEGameplayData (`souls_like_rules`, generated by the Python
## domain), so both runtimes resolve identical duels: tests/ce_test_runner.gd replays the 9 reference scenarios.
## Positions are plain 64-bit floats (canonical ground plane, Z-up, -Y forward), not Vector3 (32-bit), so the
## arithmetic matches Python. Animation is not decided here: Godot plays baked clips (authored in Blender) by state.
##
## Call `feed(fighter_id, input)` for every fighter, then `step()` once per frame.
class_name CESoulsCombat
extends RefCounted

const FRAME_RATE := 60
const FALLBACK_BONE := "STERNUM"

enum S { IDLE, WALK, GUARD, STARTUP, ACTIVE, RECOVERY, DODGE, HITSTUN, STAGGER, KO }
const STATE_NAMES := ["idle", "walk", "guard", "startup", "active", "recovery", "dodge", "hitstun", "stagger", "ko"]


class SoulsInput:
	var direction := ""      # "", "F" (towards the lock-on target), "B", "L", "R"
	var light := false
	var heavy := false
	var dodge := false
	var guard := false

	static func from_dict(d: Dictionary) -> SoulsInput:
		var i := SoulsInput.new()
		i.direction = str(d.get("direction", ""))
		i.light = bool(d.get("light", false))
		i.heavy = bool(d.get("heavy", false))
		i.dodge = bool(d.get("dodge", false))
		i.guard = bool(d.get("guard", false))
		return i


class Fighter:
	var fighter_id: String
	var px := 0.0
	var py := 0.0
	var weapon: Dictionary = {}          # entry of CEGameplayData.weapons()
	var stature_m := 1.80
	var health := 100.0
	var stamina := 100.0
	var poise := 50.0
	var state: int = S.IDLE
	var state_frames := 0
	var current_move := ""
	var chain := 0
	var stun_frames := 0
	var guarding := false
	var walk_dir := ""
	var dvx := 0.0
	var dvy := 0.0
	var since_spend := 10000
	var since_poise_hit := 10000
	var buffered: Array = []             # [] or [frame pressed, action]
	var wounds: Array = []
	var hitboxes: Dictionary = {}

	func alive() -> bool:
		return state != S.KO

	func distance_to(o: Fighter) -> float:
		var dx := px - o.px
		var dy := py - o.py
		return sqrt(dx * dx + dy * dy)

	func state_name() -> String:
		return STATE_NAMES[state]


var data: CEGameplayData
var rules: Dictionary
var t: Dictionary
var moves: Dictionary
var fighters: Dictionary = {}
var frame := 0
var events: Array = []
var hits: Array = []
var _resolved: Dictionary = {}

signal souls_event(ev: Dictionary)


func _init(p_data: CEGameplayData, p_fighters: Array) -> void:
	data = p_data
	rules = data.souls_rules()
	t = rules.get("tuning", {})
	moves = rules.get("moves", {})
	for f in p_fighters:
		fighters[f.fighter_id] = f
		if f.hitboxes.is_empty():
			f.hitboxes = data.hitboxes(f.stature_m)


static func _r(v: float) -> float:
	return snappedf(v, 0.000001)


func make_fighter(id: String, x: float, y: float, weapon_id: String) -> Fighter:
	var f := Fighter.new()
	f.fighter_id = id
	f.px = x
	f.py = y
	f.weapon = data.weapon(weapon_id)
	f.stamina = float(t["stamina_max"])
	f.poise = float(t["poise_max"])
	return f


# ---- helpers ---------------------------------------------------------------------------------------------
func nearest_opponent(f: Fighter) -> Fighter:
	var best: Fighter = null
	var best_d := INF
	for o in fighters.values():
		if o == f or not o.alive():
			continue
		var d: float = f.distance_to(o)
		if d < best_d:
			best_d = d
			best = o
	return best


func _emit(fighter: String, kind: String, detail := "") -> void:
	var ev := {"frame": frame, "fighter": fighter, "kind": kind, "detail": detail}
	events.append(ev)
	souls_event.emit(ev)


func _dir_vector(f: Fighter, direction: String) -> Vector2:
	var fx := 0.0
	var fy := -1.0
	var tgt := nearest_opponent(f)
	if tgt != null and f.distance_to(tgt) >= 1e-9:
		var d := f.distance_to(tgt)
		fx = (tgt.px - f.px) / d
		fy = (tgt.py - f.py) / d
	match direction:
		"F":
			return Vector2(fx, fy)
		"L":
			return Vector2(-fy, fx)
		"R":
			return Vector2(fy, -fx)
	return Vector2(-fx, -fy)      # "B" and no direction (back-step)


func _spend(f: Fighter, cost: float) -> void:
	f.stamina = _r(f.stamina - cost)
	f.since_spend = 0


# ---- input -----------------------------------------------------------------------------------------------
func feed(fighter_id: String, inp: SoulsInput) -> void:
	var f: Fighter = fighters[fighter_id]
	if not f.alive():
		return
	f.walk_dir = inp.direction
	f.guarding = inp.guard
	if inp.dodge:
		f.buffered = [frame, "dodge:" + inp.direction]
	elif inp.heavy:
		f.buffered = [frame, "heavy"]
	elif inp.light:
		f.buffered = [frame, "light"]
	_try_buffered(f)


func _try_buffered(f: Fighter) -> void:
	if f.buffered.is_empty():
		return
	var pressed: int = f.buffered[0]
	var action: String = f.buffered[1]
	if frame - pressed > int(t["input_buffer_frames"]):
		f.buffered = []
		return
	var free := f.state == S.IDLE or f.state == S.WALK or f.state == S.GUARD
	var in_recovery := f.state == S.RECOVERY
	if action.begins_with("dodge"):
		if not (free or (in_recovery and f.state_frames >= int(t["dodge_cancel_from"]))):
			return
		f.buffered = []
		var dir := action.substr(6)
		if f.stamina < float(t["dodge_cost"]):
			_emit(f.fighter_id, "no_stamina", "dodge")
			return
		_spend(f, float(t["dodge_cost"]))
		var v := _dir_vector(f, dir)
		var step := float(t["dodge_distance"]) / float(t["dodge_frames"])
		f.dvx = v.x * step
		f.dvy = v.y * step
		f.state = S.DODGE
		f.state_frames = 0
		f.current_move = ""
		f.chain = 0
		_emit(f.fighter_id, "dodge", dir if dir != "" else "back")
		return
	var chaining: bool = (in_recovery and f.current_move != "" and moves[f.current_move]["kind"] == "light"
			and f.state_frames <= int(t["chain_window"]) and (action == "heavy" or f.chain < int(t["max_chain"])))
	if not (free or chaining):
		return
	f.buffered = []
	var mv: Dictionary = moves["%s_%s" % [f.weapon["weapon_id"], action]]
	if f.stamina < float(mv["stamina_cost"]):
		_emit(f.fighter_id, "no_stamina", mv["move_id"])
		return
	_spend(f, float(mv["stamina_cost"]))
	if chaining and action == "light":
		f.chain = f.chain + 1
	else:
		f.chain = 1 if action == "light" else 0
	f.state = S.STARTUP
	f.state_frames = 0
	f.current_move = mv["move_id"]
	_resolved[f.fighter_id] = false
	_emit(f.fighter_id, "move_start", "%s#%d" % [mv["move_id"], f.chain] if action == "light" else mv["move_id"])


# ---- simulation ------------------------------------------------------------------------------------------
func step() -> void:
	frame += 1
	for f in fighters.values():
		if not f.alive():
			continue
		f.state_frames += 1
		f.since_spend += 1
		f.since_poise_hit += 1
		_regen(f)
		match f.state:
			S.STARTUP:
				var mv: Dictionary = moves[f.current_move]
				if f.state_frames > int(mv["startup"]):
					f.state = S.ACTIVE
					f.state_frames = 0
					_resolve_hit(f, mv)
			S.ACTIVE:
				var mv: Dictionary = moves[f.current_move]
				if not _resolved.get(f.fighter_id, false):
					_resolve_hit(f, mv)
				if f.state_frames >= int(mv["active"]):
					f.state = S.RECOVERY
					f.state_frames = 0
			S.RECOVERY:
				if f.state_frames >= int(moves[f.current_move]["recovery"]):
					f.state = S.IDLE
					f.state_frames = 0
					f.current_move = ""
					f.chain = 0
			S.DODGE:
				f.px = _r(f.px + f.dvx)
				f.py = _r(f.py + f.dvy)
				if f.state_frames >= int(t["dodge_frames"]):
					f.state = S.IDLE
					f.state_frames = 0
			S.HITSTUN, S.STAGGER:
				if f.state_frames >= f.stun_frames:
					f.state = S.IDLE
					f.state_frames = 0
		if f.state == S.IDLE or f.state == S.WALK or f.state == S.GUARD:
			_locomotion(f)
		_try_buffered(f)
		f.walk_dir = ""        # held inputs must be fed every frame
		f.guarding = false


func _regen(f: Fighter) -> void:
	if f.since_spend > float(t["regen_delay"]) and f.state != S.STARTUP and f.state != S.ACTIVE and f.state != S.DODGE:
		var rate := float(t["stamina_regen"]) * (float(t["guard_regen_factor"]) if f.state == S.GUARD else 1.0)
		f.stamina = _r(minf(float(t["stamina_max"]), f.stamina + rate))
	if f.since_poise_hit > float(t["poise_regen_delay"]):
		f.poise = _r(minf(float(t["poise_max"]), f.poise + float(t["poise_regen"])))


func _locomotion(f: Fighter) -> void:
	if f.guarding:
		f.state = S.GUARD
		return
	if f.walk_dir != "":
		var v := _dir_vector(f, f.walk_dir)
		var step := float(t["walk_speed"]) / FRAME_RATE
		f.px = _r(f.px + v.x * step)
		f.py = _r(f.py + v.y * step)
		f.state = S.WALK
	else:
		f.state = S.IDLE


func _armoured(f: Fighter) -> bool:
	if f.current_move == "":
		return false
	var mv: Dictionary = moves[f.current_move]
	if mv.get("armour_from") == null:
		return false
	return (f.state == S.STARTUP and f.state_frames >= int(mv["armour_from"])) or f.state == S.ACTIVE


func _resolve_hit(a: Fighter, mv: Dictionary) -> void:
	_resolved[a.fighter_id] = true
	var target := nearest_opponent(a)
	var reach := float(rules["base_reach_m"]) * (a.stature_m / 1.80) + float(a.weapon["reach_m"])
	if target == null or a.distance_to(target) > reach:
		_emit(a.fighter_id, "whiff", mv["move_id"])
		return
	if target.state == S.DODGE and target.state_frames >= int(t["iframe_start"]) and target.state_frames <= int(t["iframe_end"]):
		_emit(target.fighter_id, "dodged", mv["move_id"])
		return
	var energy := float(mv["energy_j"])
	if target.state == S.GUARD:
		target.stamina = _r(target.stamina - energy / float(t["block_divisor"]))
		target.since_spend = 0
		if target.stamina <= 0.0:
			target.stamina = 0.0
			_stun(target, S.STAGGER, int(t["stagger_frames"]))
			_emit(target.fighter_id, "guard_break", mv["move_id"])
		else:
			_emit(target.fighter_id, "blocked", mv["move_id"])
		return
	var bone: String = mv["target_bone"] if target.hitboxes.has(mv["target_bone"]) else FALLBACK_BONE
	var impact: Dictionary = (mv["impacts"] as Dictionary).get(bone, {})
	target.wounds.append(impact)
	target.health = _r(maxf(0.0, target.health - float(impact["health_cost"])))
	target.poise = _r(target.poise - float(mv["poise_damage"]))
	target.since_poise_hit = 0
	var hit := {"frame": frame, "attacker": a.fighter_id, "defender": target.fighter_id, "move_id": mv["move_id"],
			"bone_hit": bone, "energy_j": energy, "severity": int(impact["severity"])}
	hits.append(hit)
	_emit(target.fighter_id, "hit", "%s->%s sev%d" % [mv["move_id"], bone, int(impact["severity"])])
	if target.health <= 0.0 or bool(impact["is_lethal"]):
		target.state = S.KO
		target.state_frames = 0
		target.current_move = ""
		_emit(target.fighter_id, "ko")
	elif target.poise <= 0.0:
		target.poise = float(t["poise_max"])
		_stun(target, S.STAGGER, int(t["stagger_frames"]))
		_emit(target.fighter_id, "poise_break", mv["move_id"])
	elif _armoured(target):
		_emit(target.fighter_id, "armoured", mv["move_id"])
	else:
		_stun(target, S.HITSTUN, int(mv["hitstun"]))


func _stun(f: Fighter, state: int, frames: int) -> void:
	f.state = state
	f.state_frames = 0
	f.stun_frames = frames
	f.current_move = ""
	f.chain = 0
	f.buffered = []


## Deterministic enemy pattern: approach -> telegraph -> light, light, heavy -> punish window -> step back.
class Sentinel:
	var fighter_id: String
	var t: Dictionary
	var phase := "approach"
	var phase_frames := 0
	var presses := 0

	func _init(id: String, tuning: Dictionary) -> void:
		fighter_id = id
		t = tuning

	func _go(p: String) -> void:
		phase = p
		phase_frames = 0
		presses = 0

	func decide(sim: CESoulsCombat) -> SoulsInput:
		var me: Fighter = sim.fighters[fighter_id]
		var target := sim.nearest_opponent(me)
		phase_frames += 1
		var none := SoulsInput.new()
		if target == null or not me.alive():
			return none
		if me.state == S.HITSTUN or me.state == S.STAGGER:
			if phase != "approach":
				_go("approach")
			return none
		var dist := me.distance_to(target)
		if phase == "approach":
			if dist > float(t["engage_range"]):
				return SoulsInput.from_dict({"direction": "F"})
			_go("telegraph")
			sim._emit(fighter_id, "telegraph")
			return none
		if phase == "telegraph":
			if target.state == S.DODGE:
				phase_frames -= 1
			if phase_frames >= float(t["telegraph_frames"]):
				_go("string")
			return none
		if phase == "string":
			var plan := ["light", "light", "heavy"]
			if presses < plan.size():
				var kind: String = plan[presses]
				var ready: bool = me.state == S.IDLE or me.state == S.WALK or (
						me.state == S.RECOVERY and me.state_frames <= float(t["chain_window"]))
				if ready and me.buffered.is_empty():
					presses += 1
					return SoulsInput.from_dict({"light": kind == "light", "heavy": kind == "heavy"})
				return none
			if me.state == S.IDLE or me.state == S.WALK:
				_go("recover")
			return none
		if phase == "recover":
			if phase_frames >= float(t["punish_window"]):
				_go("retreat")
			return none
		if phase == "retreat":
			if dist < float(t["retreat_range"]):
				return SoulsInput.from_dict({"direction": "B"})
			_go("approach")
		return none


## Summary in the same shape as the Python `run_souls_scenario` output (used by tests).
func summary() -> Dictionary:
	var out_f := {}
	for fid in fighters:
		var f: Fighter = fighters[fid]
		out_f[fid] = {"health": f.health, "stamina": f.stamina, "poise": f.poise, "state": f.state_name(),
				"wounds": f.wounds.size(), "position": [f.px, f.py]}
	return {"frames": frame, "hits": hits.duplicate(true), "events": events.duplicate(true), "fighters": out_f}


## Replay a souls reference scenario spec from the JSON table (mirror of Python `run_souls_scenario`).
static func replay(p_data: CEGameplayData, spec: Dictionary) -> Dictionary:
	var weapons: Dictionary = spec.get("weapons", {})
	var d := float(spec["distance_m"])
	var sim := CESoulsCombat.new(p_data, [])
	var player := sim.make_fighter("player", 0.0, 0.0, str(weapons.get("player", "unarmed")))
	var opponent := sim.make_fighter("opponent", 0.0, -d, str(weapons.get("opponent", "unarmed")))
	for f in [player, opponent]:
		var start: Dictionary = (spec.get("start", {}) as Dictionary).get(f.fighter_id, {})
		for k in start:
			f.set(k, float(start[k]))
		sim.fighters[f.fighter_id] = f
		f.hitboxes = p_data.hitboxes(f.stature_m)
	var sentinel: Sentinel = null
	if spec.get("sentinel") != null and str(spec.get("sentinel", "")) != "":
		sentinel = Sentinel.new(str(spec["sentinel"]), sim.t)
	var script: Dictionary = spec.get("script", {})
	var hold: Dictionary = spec.get("hold", {})
	for _i in range(int(spec["frames"])):
		var key := str(sim.frame + 1)
		var inputs := {}
		for fid in hold:
			inputs[fid] = (hold[fid] as Dictionary).duplicate()
		if script.has(key):
			for fid in script[key]:
				if not inputs.has(fid):
					inputs[fid] = {}
				(inputs[fid] as Dictionary).merge(script[key][fid], true)
		if sentinel != null:
			sim.feed(sentinel.fighter_id, sentinel.decide(sim))
		for fid in inputs:
			sim.feed(fid, SoulsInput.from_dict(inputs[fid]))
		sim.step()
	var out := sim.summary()
	out["scenario_id"] = spec["scenario_id"]
	return out
