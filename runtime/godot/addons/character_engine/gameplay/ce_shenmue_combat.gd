## Shenmue-style free battle: deterministic, frame-based (60 Hz) combat state machine.
##
## Line-by-line port of `character_engine.domain.gameplay.combat.ShenmueCombat` (Python).
## Frame data, energies and the pre-computed wound assessments come from CEGameplayData
## (JSON generated by the Python domain), so both runtimes resolve identical fights: the
## reference scenarios in the JSON are replayed by tests/ce_test_runner.gd.
##
## Call `feed(fighter_id, input)` for every fighter, then `step()` once per frame.
class_name CEShenmueCombat
extends RefCounted

const FRAME_RATE := 60
const FALLBACK_BONE := "STERNUM"
const KNOCKDOWN_FRAMES := 60

enum State { IDLE, MOVE, STARTUP, ACTIVE, RECOVERY, GUARD, HITSTUN, KNOCKDOWN, GRABBED, KO }
const STATE_NAMES := ["idle", "move", "startup", "active", "recovery", "guard", "hitstun", "knockdown", "grabbed", "ko"]


class CombatInput:
	var direction: String = ""   # "", "F", "B", "U", "D"
	var punch := false
	var kick := false
	var throw := false
	var guard := false

	static func make(direction := "", punch := false, kick := false, throw := false, guard := false) -> CombatInput:
		var i := CombatInput.new()
		i.direction = direction
		i.punch = punch
		i.kick = kick
		i.throw = throw
		i.guard = guard
		return i

	static func from_dict(d: Dictionary) -> CombatInput:
		return make(str(d.get("direction", "")), bool(d.get("punch", false)), bool(d.get("kick", false)),
				bool(d.get("throw", false)), bool(d.get("guard", false)))

	func tokens() -> Array[String]:
		var out: Array[String] = []
		if direction != "":
			out.append(direction)
		if punch:
			out.append("P")
		if kick:
			out.append("K")
		if throw:
			out.append("T")
		return out

	func any_button() -> bool:
		return punch or kick or throw


class Fighter:
	var fighter_id: String
	var position := Vector3.ZERO          # canonical frame (Z-up, -Y forward) like the Python domain
	var facing := Vector3(0, -1, 0)
	var stature_m := 1.80
	var health := 100.0
	var state: int = State.IDLE
	var state_frames := 0
	var current_move := ""
	var guarding := false
	var stun_frames := 18
	var input_history: Array = []         # [frame, token]
	var wounds: Array = []                # impact dictionaries
	var hitboxes: Dictionary = {}         # bone -> radius m

	func _init(id: String, pos := Vector3.ZERO, stature := 1.80) -> void:
		fighter_id = id
		position = pos
		stature_m = stature

	func alive() -> bool:
		return state != State.KO

	func distance_to(other: Fighter) -> float:
		var dx := position.x - other.position.x
		var dy := position.y - other.position.y
		return sqrt(dx * dx + dy * dy)

	func state_name() -> String:
		return STATE_NAMES[state]

	func can_act() -> bool:
		return state == State.IDLE or state == State.MOVE or state == State.GUARD


var data: CEGameplayData
var moves: Dictionary = {}                # move_id -> Dictionary (from JSON)
var fighters: Dictionary = {}             # fighter_id -> Fighter
var input_buffer := 12
var frame := 0
var events: Array = []                    # {frame, fighter, kind, detail}
var hits: Array = []                      # {frame, attacker, defender, move_id, bone_hit, blocked, knockdown, severity, impact}
var _pending_hit: Dictionary = {}

signal hit_landed(hit: Dictionary)
signal combat_event(ev: Dictionary)


func _init(p_data: CEGameplayData, p_fighters: Array, style_id := "shenmue") -> void:
	data = p_data
	var st := data.style(style_id)
	input_buffer = int(st.get("input_buffer_frames", 12))
	for mid in st.get("moves", data.moves().keys()):
		if data.moves().has(mid):
			moves[mid] = data.moves()[mid]
	for f in p_fighters:
		fighters[f.fighter_id] = f
		if f.hitboxes.is_empty():
			f.hitboxes = data.hitboxes(f.stature_m)


# ---- input -------------------------------------------------------------------------
func _match_command(f: Fighter) -> Dictionary:
	var recent: Array = []
	for entry in f.input_history:
		if frame - int(entry[0]) <= input_buffer:
			recent.append(entry[1])
	var best := {}
	for mv in moves.values():
		var cmd: Array = mv["command"]
		if recent.size() >= cmd.size() and recent.slice(recent.size() - cmd.size()) == cmd:
			if best.is_empty() or cmd.size() > (best["command"] as Array).size():
				best = mv
	return best


func feed(fighter_id: String, inp: CombatInput) -> void:
	var f: Fighter = fighters[fighter_id]
	f.guarding = inp.guard and f.can_act()
	for tok in inp.tokens():
		if f.input_history.is_empty() or f.input_history.back()[0] != frame or f.input_history.back()[1] != tok:
			f.input_history.append([frame, tok])
	var kept: Array = []
	for entry in f.input_history:
		if frame - int(entry[0]) <= input_buffer * 2:
			kept.append(entry)
	f.input_history = kept
	if f.can_act() and inp.any_button():
		var mv := _match_command(f)
		if not mv.is_empty():
			_start_move(f, mv)
	elif f.state == State.RECOVERY and f.current_move != "" and (inp.punch or inp.kick):
		var mv := _match_command(f)
		if not mv.is_empty() and (moves[f.current_move]["cancel_into"] as Array).has(mv["move_id"]):
			_start_move(f, mv)


func _start_move(f: Fighter, mv: Dictionary) -> void:
	f.state = State.STARTUP
	f.state_frames = 0
	f.current_move = mv["move_id"]
	f.guarding = false
	f.input_history.clear()
	_pending_hit[f.fighter_id] = false
	_emit(f.fighter_id, "move_start", mv["move_id"])


# ---- simulation --------------------------------------------------------------------
func nearest_opponent(f: Fighter) -> Fighter:
	var best: Fighter = null
	var best_d := INF
	for o in fighters.values():
		if o == f or not o.alive():
			continue
		var d: float = f.distance_to(o)
		if d < best_d:
			best_d = d
			best = o
	return best


func step() -> void:
	frame += 1
	for f in fighters.values():
		if not f.alive():
			continue
		f.state_frames += 1
		match f.state:
			State.STARTUP:
				var mv: Dictionary = moves[f.current_move]
				if f.state_frames > int(mv["startup"]):
					f.state = State.ACTIVE
					f.state_frames = 0
					_resolve_hit(f, mv)   # first active frame connects
			State.ACTIVE:
				var mv: Dictionary = moves[f.current_move]
				if not _pending_hit.get(f.fighter_id, false):
					_resolve_hit(f, mv)
				if f.state_frames >= int(mv["active"]):
					f.state = State.RECOVERY
					f.state_frames = 0
			State.RECOVERY:
				var mv: Dictionary = moves[f.current_move]
				if f.state_frames >= int(mv["recovery"]):
					f.state = State.IDLE
					f.state_frames = 0
					f.current_move = ""
			State.HITSTUN, State.GRABBED:
				if f.state_frames >= f.stun_frames:
					f.state = State.IDLE
					f.state_frames = 0
			State.KNOCKDOWN:
				if f.state_frames >= KNOCKDOWN_FRAMES:
					f.state = State.IDLE
					f.state_frames = 0
			State.IDLE, State.MOVE:
				if f.guarding:
					f.state = State.GUARD
			State.GUARD:
				if not f.guarding:
					f.state = State.IDLE


func _resolve_hit(attacker: Fighter, mv: Dictionary) -> void:
	_pending_hit[attacker.fighter_id] = true
	var target := nearest_opponent(attacker)
	if target == null or attacker.distance_to(target) > float(mv["reach_m"]) * (attacker.stature_m / 1.80):
		_emit(attacker.fighter_id, "whiff", mv["move_id"])
		return
	var bone: String = mv["target_region_bone"] if target.hitboxes.has(mv["target_region_bone"]) else FALLBACK_BONE
	var blocked: bool = target.state == State.GUARD and mv["kind"] != "throw"
	var impact := {}
	var knockdown := false
	if blocked:
		_emit(target.fighter_id, "blocked", mv["move_id"])
		target.state = State.HITSTUN
		target.state_frames = 0
		target.stun_frames = maxi(4, floori(float(mv["hitstun"]) / 3.0))
	else:
		impact = data.impact(mv["move_id"], bone)
		target.wounds.append(impact)
		target.health = maxf(0.0, target.health - float(impact.get("health_cost", 0.0)))
		_emit(target.fighter_id, "hit", "%s->%s sev%d" % [mv["move_id"], bone, int(impact.get("severity", 0))])
		if target.health <= 0.0 or bool(impact.get("is_lethal", false)):
			target.state = State.KO
			target.state_frames = 0
			_emit(target.fighter_id, "ko", "")
		elif bool(mv["knockdown"]) or bool(impact.get("incapacitating", false)):
			target.state = State.KNOCKDOWN
			target.state_frames = 0
			_emit(target.fighter_id, "knockdown", mv["move_id"])
		else:
			target.state = State.HITSTUN
			target.state_frames = 0
			target.stun_frames = int(mv["hitstun"])
		knockdown = bool(mv["knockdown"])
	var hit := {
		"frame": frame, "attacker": attacker.fighter_id, "defender": target.fighter_id,
		"move_id": mv["move_id"], "bone_hit": bone, "blocked": blocked, "knockdown": knockdown,
		"severity": int(impact.get("severity", 0)), "energy_j": float(mv["energy_j"]), "impact": impact,
	}
	hits.append(hit)
	hit_landed.emit(hit)


func _emit(fighter_id: String, kind: String, detail: String) -> void:
	var ev := {"frame": frame, "fighter": fighter_id, "kind": kind, "detail": detail}
	events.append(ev)
	combat_event.emit(ev)


## Summary in the same shape as the Python `run_scenario` output (used by tests).
func summary() -> Dictionary:
	var out_hits: Array = []
	for h in hits:
		out_hits.append({"frame": h["frame"], "attacker": h["attacker"], "defender": h["defender"],
				"move_id": h["move_id"], "bone_hit": h["bone_hit"], "blocked": h["blocked"],
				"knockdown": h["knockdown"], "severity": h["severity"]})
	var out_f := {}
	for fid in fighters:
		var f: Fighter = fighters[fid]
		out_f[fid] = {"health": f.health, "state": f.state_name(), "wounds": f.wounds.size()}
	return {"frames": frame, "hits": out_hits, "events": events.duplicate(true), "fighters": out_f}


## Replay a reference scenario spec from the JSON table and return the summary.
static func replay(p_data: CEGameplayData, spec: Dictionary) -> Dictionary:
	var d := float(spec["distance_m"])
	var player := Fighter.new("player", Vector3(0, 0, 0))
	var opponent := Fighter.new("opponent", Vector3(0, -d, 0))
	opponent.facing = Vector3(0, 1, 0)
	var sim := CEShenmueCombat.new(p_data, [player, opponent], "shenmue")
	var script: Dictionary = spec["script"]
	for _i in range(int(spec["frames"])):
		var key := str(sim.frame + 1)
		if script.has(key):
			for fid in script[key]:
				sim.feed(fid, CombatInput.from_dict(script[key][fid]))
		sim.step()
	var out := sim.summary()
	out["scenario_id"] = spec["scenario_id"]
	return out
