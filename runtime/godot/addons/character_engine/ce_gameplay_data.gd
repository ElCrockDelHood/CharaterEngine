## Loader for the engine-neutral gameplay table generated by the Python domain
## (scripts/export_gameplay_data.py -> data/gameplay_shenmue.json).
##
## Godot never imports the Python domain: everything the runtime needs (moves, frame data,
## pre-computed blunt-impact assessments per hitbox bone, reference fight scenarios) is here.
class_name CEGameplayData
extends RefCounted

const DEFAULT_PATH := "res://addons/character_engine/data/gameplay_shenmue.json"
const SCHEMA := "ce-gameplay/3"

var table: Dictionary = {}
var path: String = ""


static func load_default() -> CEGameplayData:
	return load_from(DEFAULT_PATH)


static func load_from(p: String) -> CEGameplayData:
	var data := CEGameplayData.new()
	data.path = p
	if not FileAccess.file_exists(p):
		push_error("CEGameplayData: file not found: %s" % p)
		return data
	var text := FileAccess.get_file_as_string(p)
	var parsed = JSON.parse_string(text)
	if typeof(parsed) != TYPE_DICTIONARY:
		push_error("CEGameplayData: invalid JSON in %s" % p)
		return data
	data.table = parsed
	if data.table.get("schema", "") != SCHEMA:
		push_warning("CEGameplayData: schema %s != %s" % [data.table.get("schema"), SCHEMA])
	return data


func is_valid() -> bool:
	return table.has("moves") and table.has("styles")


func frame_rate() -> int:
	return int(table.get("frame_rate", 60))


func styles() -> Dictionary:
	return table.get("styles", {})


func style(style_id: String) -> Dictionary:
	return styles().get(style_id, {})


func style_ids() -> PackedStringArray:
	var out := PackedStringArray()
	for k in styles().keys():
		out.append(str(k))
	out.sort()
	return out


func moves() -> Dictionary:
	return table.get("moves", {})


func move(move_id: String) -> Dictionary:
	return moves().get(move_id, {})


## Moves available for a style, in table order.
func moves_for_style(style_id: String) -> Array:
	var out: Array = []
	for mid in style(style_id).get("moves", []):
		if moves().has(mid):
			out.append(moves()[mid])
	return out


func hitboxes(stature_m: float = 1.80) -> Dictionary:
	var k := stature_m / 1.80
	var out := {}
	for bone in table.get("hitboxes_1p80", {}).keys():
		out[bone] = snappedf(float(table["hitboxes_1p80"][bone]) * k, 0.0001)
	return out


## Pre-computed wound assessment of `move_id` landing on `bone` (see Python trauma domain).
func impact(move_id: String, bone: String) -> Dictionary:
	var mv := move(move_id)
	var impacts: Dictionary = mv.get("impacts", {})
	if impacts.has(bone):
		return impacts[bone]
	return impacts.get(table.get("fallback_bone", "STERNUM"), {})


func weapons() -> Dictionary:
	return table.get("weapons", {})


## Weapon entry (reach, energy multiplier, grip bone, placeholder size...); unknown ids -> default weapon.
func weapon(weapon_id: String) -> Dictionary:
	return weapons().get(weapon_id, weapons().get(table.get("default_weapon", "unarmed"), {}))


## True when the weapon modifies `move_id` (hand strike on the grip side, or two-handed).
func weapon_applies(weapon_id: String, move_id: String) -> bool:
	return (weapon(weapon_id).get("applies_to_moves", []) as Array).has(move_id)


## Pre-computed wound assessment of `move_id` struck with `weapon_id` on `bone`.
func weapon_impact(weapon_id: String, move_id: String, bone: String) -> Dictionary:
	var impacts: Dictionary = (weapon(weapon_id).get("impacts", {}) as Dictionary).get(move_id, {})
	if impacts.has(bone):
		return impacts[bone]
	return impacts.get(table.get("fallback_bone", "STERNUM"), {})


## Souls-like rules (STYLE-SOULS-001): tuning, per-weapon moves with energy and impacts, reference scenarios.
func souls_rules() -> Dictionary:
	return table.get("souls_like_rules", {})


func souls_reference_scenarios() -> Array:
	return souls_rules().get("reference_scenarios", [])


func reference_scenarios() -> Array:
	return table.get("reference_scenarios", [])


## Structural equality tolerant to JSON typing (int vs float, Array[T] vs Array).
## Returns true when `a` and `b` describe the same data; `diff` (optional) receives the
## first mismatching path for diagnostics.
static func deep_equal(a, b, diff: Array = [], path: String = "$") -> bool:
	var ta := typeof(a)
	var tb := typeof(b)
	if (ta == TYPE_INT or ta == TYPE_FLOAT) and (tb == TYPE_INT or tb == TYPE_FLOAT):
		if is_equal_approx(float(a), float(b)):
			return true
		diff.append("%s: %s != %s" % [path, a, b])
		return false
	if ta == TYPE_DICTIONARY and tb == TYPE_DICTIONARY:
		if a.size() != b.size():
			diff.append("%s: size %d != %d" % [path, a.size(), b.size()])
			return false
		for k in a:
			if not b.has(k):
				diff.append("%s: missing key %s" % [path, k])
				return false
			if not deep_equal(a[k], b[k], diff, "%s.%s" % [path, k]):
				return false
		return true
	if (ta == TYPE_ARRAY or ta == TYPE_PACKED_STRING_ARRAY) and (tb == TYPE_ARRAY or tb == TYPE_PACKED_STRING_ARRAY):
		if a.size() != b.size():
			diff.append("%s: length %d != %d" % [path, a.size(), b.size()])
			return false
		for i in range(a.size()):
			if not deep_equal(a[i], b[i], diff, "%s[%d]" % [path, i]):
				return false
		return true
	if a == b:
		return true
	diff.append("%s: %s != %s" % [path, a, b])
	return false
