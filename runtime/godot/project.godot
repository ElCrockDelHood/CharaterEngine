; CHARACTER ENGINE - Godot 4 runtime project.
;
; * res://ce_skeleton_validator.gd        skeleton contract validator (M21)
; * res://addons/character_engine/        editor dock + runtime (CECharacter, CEArena,
;                                          CEShenmueCombat, CEBreathing) consuming the
;                                          exported GLB and the generated gameplay table
; * res://tests/ce_test_runner.gd         headless test suite (scripts/engine_tests.py godot)
;
; Renderer is "Compatibility" (OpenGL 3.3) on purpose: right choice for integrated GPUs
; such as Intel HD Graphics 620 (see docs/07_Godot.md).
;
; Assets under res://assets/*.glb are regenerated by scripts/engine_tests.py or:
;   python scripts/export_gltf.py -o runtime/godot/assets/human_adult_206.glb
;   python scripts/export_gltf.py --pose tpose -o runtime/godot/assets/human_adult_206_tpose.glb
; Headless tests:
;   godot4 --headless --path runtime/godot --script res://tests/ce_test_runner.gd

config_version=5

[application]

config/name="CharacterEngineRuntime"
config/features=PackedStringArray("4.3")
run/main_scene=""

[editor_plugins]

enabled=PackedStringArray("res://addons/character_engine/plugin.cfg")

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
