## Character Engine - Godot headless test runner.
##
##   godot --headless --path runtime/godot --script res://tests/ce_test_runner.gd -- --report <file.json>
##
## Checks (each PASS/FAIL line is printed; a JSON report is written for scripts/engine_tests.py):
##   - gameplay table (generated by the Python domain) loads and is complete
##   - anatomical and T-pose GLB pass the skeleton contract (208 bones, Y-up, ground)
##   - T-pose: humerus horizontal, arms spread along X
##   - CECharacter loads in-tree, finds canonical bones, reports stature; scaling works
##   - CEBreathing modifier displaces the sternum over time
##   - CEShenmueCombat replays every reference fight identically to the Python simulation (incl. weapons)
##   - CESoulsCombat replays the 9 Souls-like reference scenarios identically to Python
##   - the D1 reaction library JSON (generated offline in Blender, schema 3) loads with a wound, a reaction and its
##     playback per contact (defender and attacker reacting from the frame after contact, NLA blend-in)
##   - weapons table complete; weapon placeholder mounts on the grip bone and follows it when posed
##   - CEArena builds two characters + controllers, autoplay lands hits and creates wound markers
##   - face: 20 game shapes only (52 stay in Blender), jaw / eye rotations equal to Python, eyes aim with the neck turned
##   - CE-GAME-v1 game GLB: contract, canonical bones at their anatomical positions, markers / weapon on the
##     carrying game bone, and the arena fight identical to the canonical skeleton
##   - InputMap actions registered; planned gameplay styles are listed but disabled
extends SceneTree

const VALIDATOR := preload("res://ce_skeleton_validator.gd")

var report_path := ""
var results: Array = []


func _initialize() -> void:
	var args := OS.get_cmdline_user_args()
	for i in range(args.size()):
		if args[i] == "--report" and i + 1 < args.size():
			report_path = args[i + 1]
	if report_path == "":
		report_path = ProjectSettings.globalize_path("res://").path_join("../../builds/tests/godot_report.json")
	print("== Character Engine Godot test runner (Godot %s, headless=%s) ==" % [
			Engine.get_version_info()["string"], DisplayServer.get_name() == "headless"])
	var runner := Runner.new()
	runner.owner_tree = self
	root.add_child(runner)


func check(name: String, fn: Callable) -> void:
	var status := "PASS"
	var detail := ""
	var out = fn.call()
	if out is String:
		detail = out
	elif out is Array and out.size() == 2:
		detail = str(out[1])
		if not out[0]:
			status = "FAIL"
	elif out is bool and not out:
		status = "FAIL"
	elif out == null:
		status = "FAIL"
		detail = "check returned nothing (script error?)"
	results.append({"check": name, "status": status, "detail": detail})
	print("  %s  %s  %s" % [status, name, detail])


func finish() -> void:
	var failed := 0
	for r in results:
		if r["status"] == "FAIL":
			failed += 1
	var passed := results.size() - failed
	var data := {"engine": "godot", "godot_version": Engine.get_version_info()["string"],
			"passed": passed, "failed": failed, "results": results}
	var dir := report_path.get_base_dir()
	DirAccess.make_dir_recursive_absolute(dir)
	var f := FileAccess.open(report_path, FileAccess.WRITE)
	if f:
		f.store_string(JSON.stringify(data, "  "))
		f.close()
		print("report: " + report_path)
	else:
		print("could not write report to " + report_path)
	print("== godot: %d passed, %d failed ==" % [passed, failed])
	quit(1 if failed > 0 else 0)


class Runner extends Node:
	var owner_tree: SceneTree

	## Quaternion distance against a Python (w, x, y, z) canonical quaternion (q and -q are the same rotation).
	static func _quat_err(q: Quaternion, ref: Array) -> float:
		var r := Quaternion(float(ref[1]), float(ref[3]), -float(ref[2]), float(ref[0]))   # canonical -> Y-up axes
		var a := Vector4(q.x, q.y, q.z, q.w)
		var b := Vector4(r.x, r.y, r.z, r.w)
		return minf((a - b).length(), (a + b).length())

	func _ready() -> void:
		await get_tree().process_frame   # root is still setting up children during _initialize
		await run_all()

	func run_all() -> void:
		var t: SceneTree = owner_tree
		var runner: Object = t
		var tree_root: Window = t.root

		# ---- data --------------------------------------------------------------
		var data := CEGameplayData.load_default()
		runner.check("gameplay table loads (generated by Python domain)", func():
			return [data.is_valid() and data.table.get("schema") == CEGameplayData.SCHEMA,
					"%d moves, styles %s" % [data.moves().size(), ", ".join(data.style_ids())]])
		runner.check("shenmue move set complete with frame data and impacts", func():
			var mvs := data.moves_for_style("shenmue")
			var ok := mvs.size() == 8
			for mv in mvs:
				ok = ok and int(mv["startup"]) > 0 and int(mv["active"]) > 0 and (mv["impacts"] as Dictionary).size() >= 20
			return [ok, "%d moves, %d impact bones each" % [mvs.size(), (mvs[0]["impacts"] as Dictionary).size() if mvs else 0]])
		runner.check("planned gameplay styles listed but without moves", func():
			var planned := 0
			for sid in data.style_ids():
				if (data.style(sid).get("moves", []) as Array).is_empty():
					planned += 1
			return [planned >= 2 and not (data.style("shenmue").get("moves", []) as Array).is_empty(), "%d planned styles" % planned])

		# ---- assets --------------------------------------------------------------
		var anat := "res://assets/human_adult_206.glb"
		var tpose := "res://assets/human_adult_206_tpose.glb"
		runner.check("anatomical GLB passes skeleton contract", func():
			var r: Dictionary = VALIDATOR.validate_file(anat)
			return [r.get("passed", false), "%s bones, height %.3f m, errors %s" % [r.get("bone_count"), r.get("height_m", 0.0), r.get("errors", [])]])
		runner.check("T-pose GLB passes skeleton contract", func():
			var r: Dictionary = VALIDATOR.validate_file(tpose)
			return [r.get("passed", false), "%s bones, height %.3f m" % [r.get("bone_count"), r.get("height_m", 0.0)]])

		# ---- character -----------------------------------------------------------
		var ch := CECharacter.new()
		ch.glb_path = tpose
		ch.breathing_enabled = true
		tree_root.add_child(ch)
		runner.check("CECharacter loads T-pose GLB in tree", func():
			return [ch.skeleton != null and ch.bone_count() == CECharacter.EXPECTED_BONES and ch.has_bone("STERNUM") and ch.has_bone("PHALANX_DISTAL_3_L"),
					"%d bones, err='%s'" % [ch.bone_count(), ch.load_error]])
		runner.check("T-pose: humerus horizontal and arms spread along X", func():
			var h := ch.bone_rest_position("HUMERUS_L")
			var r := ch.bone_rest_position("RADIUS_L")
			var d := r - h
			return [absf(d.y) < 0.05 and absf(d.x) > 0.25, "HUMERUS_L->RADIUS_L delta %s" % d])
		runner.check("stature 1.80 m and rescaling to 1.65 m", func():
			var h180 := ch.height_m()
			ch.stature_m = 1.65
			var h165 := ch.height_m()
			ch.stature_m = 1.80
			# joint-to-joint height (no scalp/heel soft tissue) is ~1.76 m for the 1.80 m template
			return [h180 > 1.70 and h180 < 1.82 and absf(h165 / h180 - 1.65 / 1.80) < 0.01, "%.3f m -> %.3f m" % [h180, h165]])

		# Modifier output is visible to skinning and BoneAttachment3D (skeleton_updated), not to
		# get_bone_pose(): sample an attachment on the sternum across frames.
		var probe := BoneAttachment3D.new()
		probe.bone_name = "STERNUM"
		ch.skeleton.add_child(probe)
		await t.process_frame
		var sternum0 := probe.global_position
		for _i in range(8):
			await t.process_frame
		var sternum1 := probe.global_position
		runner.check("CEBreathing modifier displaces the sternum over time", func():
			var moved := sternum0.distance_to(sternum1)
			return [ch.breathing != null and moved > 1e-4 and moved < 0.05 and absf(ch.breathing.last_offset_m) > 0.0,
					"moved %.4f m, offset %.4f m after 8 frames" % [moved, ch.breathing.last_offset_m]])

		var marker := ch.add_wound_marker("STERNUM", data.impact("elbow_assault", "STERNUM"))
		runner.check("wound marker attached to bone with severity colour", func():
			return [marker != null and marker is BoneAttachment3D and ch.wound_markers.size() == 1,
					"impact %s" % data.impact("elbow_assault", "STERNUM")])
		ch.queue_free()

		# ---- weapons ---------------------------------------------------------------
		runner.check("weapons table: unarmed applies to nothing, examples carry provenance", func():
			var ws := data.weapons()
			var ok := ws.has("unarmed") and ws.has("staff") and ws.has("short_blade")
			ok = ok and (data.weapon("unarmed")["applies_to_moves"] as Array).is_empty()
			for wid in ws:
				for k in (ws[wid]["provenance"] as Dictionary):
					ok = ok and ws[wid]["provenance"][k] != "proven"
			return [ok and data.weapon_applies("short_blade", "jab") and not data.weapon_applies("short_blade", "front_kick"),
					"%s; short_blade -> %s" % [", ".join(ws.keys()), data.weapon("short_blade")["applies_to_moves"]]])
		var wch := CECharacter.new()
		wch.glb_path = tpose
		wch.breathing_enabled = false
		tree_root.add_child(wch)
		var blade := data.weapon("short_blade")
		var watt := wch.equip_weapon(blade)
		var grip: String = blade["grip_bone"]
		await t.process_frame
		await t.process_frame
		var w0 := watt.global_position if watt else Vector3.ZERO
		runner.check("weapon placeholder mounted on grip bone (BoneAttachment3D)", func():
			var box: BoxMesh = (watt.get_child(0) as MeshInstance3D).mesh if watt and watt.get_child_count() > 0 else null
			return [watt != null and watt.bone_name == grip and box != null
					and is_equal_approx(box.size.y, float(blade["length_m"])) and wch.equip_weapon(data.weapon("unarmed")) == null
					and w0.distance_to(wch.bone_global_position(grip)) < 1e-3,
					"%s on %s, box %s" % [watt.name if watt else "null", grip, box.size if box else "none"]])
		watt = wch.equip_weapon(blade)   # the unarmed probe above unequipped it
		await t.process_frame
		var hum := wch.skeleton.find_bone("HUMERUS_R")
		wch.skeleton.set_bone_pose_rotation(hum, wch.skeleton.get_bone_rest(hum).basis.get_rotation_quaternion()
				* Quaternion(Vector3(0, 0, 1), 0.8))
		await t.process_frame
		await t.process_frame
		var w1 := watt.global_position
		runner.check("weapon placeholder follows the grip bone when the arm is posed", func():
			var err := w1.distance_to(wch.bone_global_position(grip))
			return [w1.distance_to(w0) > 0.05 and err < 1e-3, "moved %.3f m, error to bone %.5f m" % [w1.distance_to(w0), err]])
		wch.queue_free()

		# ---- game rig CE-GAME-v1 (RIG-GAME-001 step 2) ---------------------------------
		var game_tpose := "res://assets/human_game_v1_tpose.glb"
		runner.check("game GLBs pass the CE-GAME-v1 contract", func():
			var r: Dictionary = VALIDATOR.validate_file(game_tpose)
			var r2: Dictionary = VALIDATOR.validate_file("res://assets/human_game_v1.glb")
			return [r.get("passed", false) and r2.get("passed", false) and r.get("rig_id") == "CE-GAME-v1",
					"%s bones, height %.3f m, errors %s %s" % [r.get("bone_count"), r.get("height_m", 0.0), r.get("errors", []), r2.get("errors", [])]])
		var gch := CECharacter.new()
		gch.glb_path = game_tpose
		gch.breathing_enabled = false
		tree_root.add_child(gch)
		var cch := CECharacter.new()
		cch.glb_path = tpose
		cch.breathing_enabled = false
		tree_root.add_child(cch)
		runner.check("game rig maps every canonical bone at its anatomical position", func():
			var worst := 0.0
			var worst_bone := ""
			var mapped := 0
			for i in range(cch.skeleton.get_bone_count()):
				var n := cch.skeleton.get_bone_name(i)
				if n == "ROOT_SKELETON" or n == "CRANIUM":
					continue   # containers: centroid placement, not anatomical points
				mapped += 1 if gch.has_bone(n) else 0
				var d := gch.bone_rest_position(n).distance_to(cch.bone_rest_position(n))
				if d > worst:
					worst = d
					worst_bone = n
			return [gch.is_game_rig() and gch.bone_count() == 66 and gch.game_map.size() == 208 and mapped == 206 and worst < 1e-4,
					"%d bones, %d canonical mapped, worst %s %.6f m" % [gch.bone_count(), mapped, worst_bone, worst]])
		var gm := gch.add_wound_marker("RIB_08_L", data.impact("hook", "RIB_08_L"))
		var gblade := gch.equip_weapon(data.weapon("short_blade"))
		var cblade := cch.equip_weapon(data.weapon("short_blade"))
		await t.process_frame
		await t.process_frame
		var g_mesh0: Vector3 = (gblade.get_child(0) as Node3D).global_position
		var g_off0 := g_mesh0.distance_to(gch.bone_global_position("METACARPAL_3_R"))
		runner.check("game rig: wound marker rides on spine_03 at RIB_08_L", func():
			var d := (gm.get_child(0) as Node3D).global_position.distance_to(cch.bone_rest_position("RIB_08_L"))
			return [gm.bone_name == "spine_03" and d < 1e-3, "%s, %.5f m from the canonical RIB_08_L" % [gm.bone_name, d]])
		runner.check("game rig: weapon on hand_r matches the canonical grip", func():
			var d := g_mesh0.distance_to((cblade.get_child(0) as Node3D).global_position)
			return [gblade.bone_name == "hand_r" and cblade.bone_name == "METACARPAL_3_R" and d < 1e-3,
					"%s vs %s, placeholder centres %.5f m apart" % [gblade.bone_name, cblade.bone_name, d]])
		var uarm := gch.skeleton.find_bone("upperarm_r")
		gch.skeleton.set_bone_pose_rotation(uarm, Quaternion(Vector3(0, 0, 1), 0.8))
		await t.process_frame
		await t.process_frame
		runner.check("game rig: weapon follows hand_r when the arm is posed", func():
			var g_mesh1: Vector3 = (gblade.get_child(0) as Node3D).global_position
			var off1 := g_mesh1.distance_to(gch.bone_global_position("METACARPAL_3_R"))
			return [g_mesh1.distance_to(g_mesh0) > 0.05 and absf(off1 - g_off0) < 1e-3,
					"moved %.3f m, grip offset %.4f -> %.4f m" % [g_mesh1.distance_to(g_mesh0), g_off0, off1]])
		gch.queue_free()
		cch.queue_free()

		# ---- face (RIG-GAME-001 step 5) -----------------------------------------------------
		var fch := CECharacter.new()
		fch.glb_path = game_tpose
		fch.breathing_enabled = false
		tree_root.add_child(fch)
		runner.check("face contract: only the 20 in-game ARKit shapes reach Godot, jaw and eyes", func():
			var game: Array = fch.face.get("game_shapes", [])
			var cinema_only := fch.face.has("arkit_52")      # the 52-shape set stays in Blender (owner rule)
			return [fch.has_face() and game.size() == 20 and game.has("jawOpen") and not cinema_only,
					"%d game shapes, cinematic set exported: %s, limits jaw %s eye yaw %s pitch %s deg" % [game.size(), cinema_only,
					fch.face.get("jaw_open_max_deg"), fch.face.get("eye_yaw_max_deg"), fch.face.get("eye_pitch_max_deg")]])
		runner.check("face: jaw and eye rotations identical to Python", func():
			var worst := 0.0
			var ref: Dictionary = fch.face["reference"]
			for k in ref["jaw"]:
				worst = maxf(worst, _quat_err(fch.set_jaw_open(float(k)), ref["jaw"][k]))
			for case in ref["eyes"]:
				var tgt: Array = ref["eyes"][case]["target"]
				var got := fch.look_at_point(fch.skeleton.global_transform * Vector3(tgt[0], tgt[2], -tgt[1]))
				for eye in got:
					worst = maxf(worst, _quat_err(got[eye], ref["eyes"][case][eye]))
			fch.set_jaw_open(0.0)
			var cases := (ref["jaw"] as Dictionary).size() + (ref["eyes"] as Dictionary).size() * 2
			return [worst < 1e-4, "%d cases (jaw + both eyes), worst quaternion difference %s" % [cases, str(worst)]])
		var neck := fch.skeleton.find_bone("neck_01")
		fch.skeleton.set_bone_pose_rotation(neck, Quaternion(Vector3.UP, deg_to_rad(30.0)))
		var target := fch.bone_global_position("head") + Vector3(0.3, 0.1, 1.0)   # Godot +Z = canonical forward
		fch.look_at_point(target)
		await t.process_frame
		runner.check("face: eyes keep aiming at a target while the neck is turned", func():
			var worst := 0.0
			for eye in ["eye_l", "eye_r"]:
				var idx := fch.skeleton.find_bone(eye)
				var pose := fch.skeleton.global_transform * fch.skeleton.get_bone_global_pose(idx)
				var aim: Vector3 = (pose.basis * (fch._face_axes[1] as Vector3)).normalized()
				worst = maxf(worst, rad_to_deg(aim.angle_to((target - pose.origin).normalized())))
			return [worst < 0.5, "neck 30 deg, worst aim error %.3f deg" % worst])
		fch.queue_free()

		# ---- combat port vs Python reference ------------------------------------
		for sc in data.reference_scenarios():
			var sid: String = sc["spec"]["scenario_id"]
			runner.check("combat replay identical to Python: " + sid, func():
				var got := CEShenmueCombat.replay(data, sc["spec"])
				var diff: Array = []
				var same := CEGameplayData.deep_equal(got, sc["expected"], diff)
				return [same, "%d hits, opponent HP %.2f%s" % [got["hits"].size(), got["fighters"]["opponent"]["health"],
						"" if same else "  diff: " + str(diff)]])

		# ---- souls-like port vs Python reference (STYLE-SOULS-001) -------------
		runner.check("souls_like rules table: 6 moves (3 weapons x light/heavy), 9 reference scenarios", func():
			var r := data.souls_rules()
			return [(r.get("moves", {}) as Dictionary).size() == 6 and data.souls_reference_scenarios().size() == 9
					and r.get("provenance") == "placeholder", "%d moves, %d scenarios, provenance %s" % [
					(r.get("moves", {}) as Dictionary).size(), data.souls_reference_scenarios().size(), r.get("provenance")]])
		for sc in data.souls_reference_scenarios():
			var ssid: String = sc["spec"]["scenario_id"]
			runner.check("souls replay identical to Python: " + ssid, func():
				var got := CESoulsCombat.replay(data, sc["spec"])
				var diff: Array = []
				var same := CEGameplayData.deep_equal(got, sc["expected"], diff)
				return [same, "%d hits, %d events, player HP %.2f st %.2f%s" % [got["hits"].size(), got["events"].size(),
						got["fighters"]["player"]["health"], got["fighters"]["player"]["stamina"],
						"" if same else "  diff: " + str(diff)]])

		# ---- D1 reaction library (generated offline in Blender, read as plain JSON) -
		runner.check("D1 reaction library: schema 3, every contact has a wound, a reaction, its playback and the attacker reaction", func():
			var path := "res://addons/character_engine/data/reaction_library_d1.json"
			if not FileAccess.file_exists(path):
				return [false, "missing " + path]
			var lib = JSON.parse_string(FileAccess.get_file_as_string(path))
			if typeof(lib) != TYPE_DICTIONARY or int(lib.get("schema_version", 0)) != 3:
				return [false, "not a schema-3 document"]
			var known := ["Death01", "Hit_Knockback", "Hit_Head", "Hit_Chest"]
			var contacts := 0
			var bad: Array = []
			for e in lib["entries"]:
				if (e["frames"] as Array).size() != (e["signed_distance_m"] as Array).size():
					bad.append(e["id"])
				if e["first_contact"] != null:
					contacts += 1
					var pb = e["reaction_playback"]
					if e["wound"] == null or not (e["reaction"]["clip"] in known) or pb == null \
							or int(pb["start_frame"]) != int(e["first_contact"]["frame"]) \
							or pb["clip"] != e["reaction"]["clip"] \
							or (pb["frames"] as Array).size() != (pb["signed_distance_m"] as Array).size() \
							or int(pb["blend_in_frames"]) < 0 \
							or (pb["attacker_reaction"] != null and int(pb["attacker_reaction"]["starts_frame"]) != int(e["first_contact"]["frame"]) + 1):
						bad.append(e["id"])
				elif e["reaction_playback"] != null:
					bad.append(e["id"])
			return [bad.is_empty() and lib["entries"].size() > 0, "%d entries, %d contacts%s" % [
					lib["entries"].size(), contacts, "" if bad.is_empty() else "  bad: " + str(bad)]])

		# ---- arena ---------------------------------------------------------------
		CEFighterController.ensure_input_map()
		runner.check("InputMap actions registered", func():
			var ok := true
			for a in CEFighterController.ACTIONS:
				ok = ok and InputMap.has_action(a)
			return [ok, ", ".join(CEFighterController.ACTIONS.keys())])
		var arena := CEArena.build(data, "shenmue", tpose)
		arena.autoplay_frames = 240
		arena.show_hud = false
		tree_root.add_child(arena)
		runner.check("CEArena builds fighters, characters and controllers", func():
			return [arena.combat != null and arena.controllers.size() == 2 and arena.characters.size() == 2
					and (arena.characters["player"] as CECharacter).bone_count() == 208,
					"style %s, %d controllers" % [arena.style_id, arena.controllers.size()]])
		for _i in range(240):
			arena.step_once()
		var summary := arena.combat.summary()
		runner.check("arena autoplay 240 frames: hits land and wounds are marked", func():
			var opp: CECharacter = arena.characters["opponent"]
			var hits: int = summary["hits"].size()
			return [hits > 0 and float(summary["fighters"]["opponent"]["health"]) < 100.0 and opp.wound_markers.size() > 0,
					"%d hits, opponent HP %.1f, %d markers, player state %s" % [hits, summary["fighters"]["opponent"]["health"],
					opp.wound_markers.size(), summary["fighters"]["player"]["state"]]])
		runner.check("fighters moved in Godot space (canonical -> Y-up mapping)", func():
			var p: CECharacter = arena.characters["player"]
			var o: CECharacter = arena.characters["opponent"]
			var d := p.global_position.distance_to(o.global_position)
			return [d < arena.start_distance_m and d > 0.2 and absf(p.global_position.y) < 1e-6,
					"distance %.2f m (start %.2f)" % [d, arena.start_distance_m]])
		var garena := CEArena.build(data, "shenmue", game_tpose)
		garena.autoplay_frames = 240
		garena.show_hud = false
		tree_root.add_child(garena)
		for _i in range(240):
			garena.step_once()
		runner.check("arena on the game rig: same fight as on the canonical skeleton", func():
			var diff: Array = []
			var same := CEGameplayData.deep_equal(garena.combat.summary(), summary, diff)
			var gopp: CECharacter = garena.characters["opponent"]
			var copp: CECharacter = arena.characters["opponent"]
			return [same and gopp.is_game_rig() and gopp.wound_markers.size() == copp.wound_markers.size(),
					"%d hits, %d markers on %s%s" % [summary["hits"].size(), gopp.wound_markers.size(),
					gopp.glb_path.get_file(), "" if same else "  diff: " + str(diff)]])
		garena.queue_free()
		arena.queue_free()
		await t.process_frame
		runner.finish()
