{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Character Engine Skeleton Schema v1.0",
  "description": "Formato de intercambio para esqueletos anatómicos",
  "type": "object",
  "required": ["schema", "schema_version", "asset", "skeleton"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "character_engine.skeleton"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "asset": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string", "default": "1.0.0" },
        "units": { "type": "string", "enum": ["meters"], "default": "meters" },
        "coordinate_system": { "type": "string", "enum": ["right-handed"], "default": "right-handed" }
      },
      "additionalProperties": false
    },
    "skeleton": {
      "type": "object",
      "required": ["canonical_name", "name", "bones"],
      "properties": {
        "canonical_name": { "type": "string" },
        "name": { "type": "string" },
        "bones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["canonical_name", "name", "head", "tail"],
            "properties": {
              "canonical_name": { "type": "string" },
              "name": { "type": "string" },
              "parent": { "type": ["string", "null"] },
              "head": {
                "type": "object",
                "required": ["x", "y", "z"],
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" },
                  "z": { "type": "number" }
                },
                "additionalProperties": false
              },
              "tail": {
                "type": "object",
                "required": ["x", "y", "z"],
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" },
                  "z": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["canonical_name", "name"],
            "properties": {
              "canonical_name": { "type": "string" },
              "name": { "type": "string" },
              "parent": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}